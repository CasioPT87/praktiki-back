{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Backend",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "program": "${workspaceFolder}/src/index.ts",
      "remoteRoot": "/app",
      "protocol": "inspector",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
      // "trace": true
    }
  ]
}
